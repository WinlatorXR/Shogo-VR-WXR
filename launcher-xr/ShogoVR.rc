// ShogoVR.rc - icon and version information for ShogoVR.exe.
#include <windows.h>

IDI_APP                  ICON                    "assets\\shogo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ShogoVR"
            VALUE "FileDescription", "Shogo: Mobile Armor Division - WinlatorXR launcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ShogoVR"
            VALUE "OriginalFilename", "ShogoVR.exe"
            VALUE "ProductName", "ShogoVR"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END