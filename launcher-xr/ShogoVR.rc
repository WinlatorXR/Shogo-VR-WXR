// ShogoVR.rc - icon, version information and the custom-mod dialogs.
#include <windows.h>
#include <commctrl.h>
#include "Resource.h"

IDI_APP                  ICON                    "assets\\shogo.ico"

// Shown when the game's Custom folder holds something besides .rez files.
// The player can mount the whole folder, pick individual .rez mods, or skip it.
IDD_MODMODE DIALOGEX 0, 0, 220, 96
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shogo VR - Custom Mods"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "The Custom folder contains files other than .rez mods.\nHow would you like to load it?",IDC_MODMODE_TEXT,10,8,200,20
    PUSHBUTTON      "Load whole Custom folder",IDC_MOD_WHOLE,10,36,200,14
    PUSHBUTTON      "Pick individual REZ files...",IDC_MOD_PICK,10,54,200,14
    PUSHBUTTON      "Continue without loading",IDC_MOD_NONE,10,72,200,14
END

// The checkbox list of .rez files in Custom.
IDD_MODLIST DIALOGEX 0, 0, 240, 184
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shogo VR - Custom Mods"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Choose the REZ mods to load from the Custom folder:",IDC_MODLIST_TEXT,10,8,220,10
    CONTROL         "",IDC_MODLIST_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | WS_VSCROLL,10,22,220,130
    PUSHBUTTON      "Continue without loading",IDCANCEL,10,164,100,14
    DEFPUSHBUTTON   "GO",IDOK,202,164,28,14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ShogoVR"
            VALUE "FileDescription", "Shogo: Mobile Armor Division - WinlatorXR launcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ShogoVR"
            VALUE "OriginalFilename", "ShogoVR.exe"
            VALUE "ProductName", "ShogoVR"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
